@article{bentonComplexPopulationDynamics2006,
  title = {Complex Population Dynamics and Complex Causation: Devils, Details and Demography},
  shorttitle = {Complex Population Dynamics and Complex Causation},
  author = {Benton, Tim G and Plaistow, Stewart J and Coulson, Tim N},
  date = {2006-05-22},
  journaltitle = {Proc. R. Soc. B.},
  volume = {273},
  number = {1591},
  pages = {1173--1181},
  issn = {0962-8452, 1471-2954},
  doi = {10.1098/rspb.2006.3495},
  url = {https://royalsocietypublishing.org/doi/10.1098/rspb.2006.3495},
  urldate = {2025-01-09},
  abstract = {Population dynamics result from the interplay of density-independent and density-dependent processes. Understanding this interplay is important, especially for being able to predict near-term population trajectories for management. In recent years, the study of model systems—experimental, observational and theoretical—has shed considerable light on the way that the both density-dependent and -independent aspects of the environment affect population dynamics via impacting on the organism's life history and therefore demography. These model-based approaches suggest that (i) individuals in different states differ in their demographic performance, (ii) these differences generate structure that can fluctuate independently of current total population size and so can influence the dynamics in important ways, (iii) individuals are strongly affected by both current and past environments, even when the past environments may be in previous generations and (iv) dynamics are typically complex and transient due to environmental noise perturbing complex population structures. For understanding population dynamics of any given system, we suggest that ‘the devil is in the detail’. Experimental dissection of empirical systems is providing important insights into the details of the drivers of demographic responses and therefore dynamics and should also stimulate theory that incorporates relevant biological mechanism.},
  langid = {english},
  file = {/home/tomasw/Zotero/storage/AGYRWA5E/Benton m. fl. - 2006 - Complex population dynamics and complex causation devils, details and demography.pdf}
}

@article{bielbyFastSlowContinuumMammalian2007,
  title = {The {{Fast-Slow Continuum}} in {{Mammalian Life History}}: {{An Empirical Reevaluation}}},
  shorttitle = {The {{Fast-Slow Continuum}} in {{Mammalian Life History}}},
  author = {Bielby, Jon and {Mace} and Bininda-Emonds, Olaf and Cardillo, M. and {Gittleman} and Jones, Kate and Orme, David and Purvis, Andy},
  date = {2007-06-01},
  journaltitle = {The American Naturalist},
  volume = {169},
  pages = {748},
  doi = {10.2307/4136994},
  abstract = {Many life‐history traits co‐vary across species, even when body size differences are controlled for. This phenomenon has led to the concept of a “fast‐slow continuum,” which has been influential in both empirical and theoretical studies of life‐history evolution. We present a comparative analysis of mammalian life histories showing that, for mammals at least, there is not a single fast‐slow continuum. Rather, both across and within mammalian clades, the speed of life varies along at least two largely independent axes when body size effects are removed. One axis reflects how species balance offspring size against offspring number, while the other describes the timing of reproductive bouts.},
  file = {/home/tomasw/Zotero/storage/6QHNEXUB/Bielby m. fl. - 2007 - The Fast-Slow Continuum in Mammalian Life History An Empirical Reevaluation.pdf}
}

@article{blackburnGeographicGradientsBody1999a,
  title = {Geographic {{Gradients}} in {{Body Size}}: {{A Clarification}} of {{Bergmann}}'s {{Rule}}},
  shorttitle = {Geographic {{Gradients}} in {{Body Size}}},
  author = {Blackburn, Tim M. and Gaston, Kevin J. and Loder, Natasha},
  date = {1999},
  journaltitle = {Diversity and Distributions},
