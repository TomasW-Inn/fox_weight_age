## modelAgeSexArea_v2.jags
##
## Revised Bayesian age-at-harvest survival model for Red fox
## following Skelly et al. (2023), with three key developments
## over the original modelAgeSexArea2.jags:
##
##  1. Region-specific population growth rates (lambda[r])
##     rather than a single shared lambda. Priors for N and NC
##     are informed by harvest index data; SC and S use a wider
##     prior reflecting greater uncertainty.
##
##  2. Dirichlet-multinomial likelihood replacing the standard
##     multinomial. This accommodates overdispersion arising from
##     year-to-year variation within groups (data pooled 1967-71)
##     that the multinomial cannot absorb. The concentration
##     parameter phi controls the degree of extra-multinomial
##     variation and is estimated from the data.
##
##  3. Age effects modelled as a second-order random walk (RW2)
##     on the logit scale. Rather than estimating each age-class
##     deviation freely (8 free parameters in the original), the
##     RW2 shrinks adjacent age effects toward a smooth curve,
##     reducing effective parameters and improving calibration
##     of the posterior predictive check (Bayesian p-value).
##
## Data required (passed from R via jagsUI):
##   y[i, 1:S]   - observed counts, group i, stage class s
##   N[i]        - total harvest in group i
##   S           - number of stage classes (9)
##   G           - number of groups (8: 4 regions x 2 sexes)
##   K           - number of regression coefficients
##   sex[i]      - sex indicator for group i (0=male, 1=female)
##   area[i]     - region index for group i (1=N, 2=NC, 3=SC, 4=S)
##
## Note on indexing: area[i] is now an integer 1:4 used to look
## up lambda[area[i]], replacing the three dummy variables
## (area3, area4, area5) in the original code.

model {

  ## -------------------------------------------------------
  ## 1. PRIORS
  ## -------------------------------------------------------

  ## Intercept - logistic(0,1) as in original
  b_intercept ~ dlogis(0, 1)

  ## Sex effect - logistic(0,1)
  b_sex ~ dlogis(0, 1)

  ## Region effects (N is reference; NC, SC, S as deviations)
  ## logistic(0,1) priors as in original
  b_region[1] <- 0          # North (reference)
  for (r in 2:4) {
    b_region[r] ~ dlogis(0, 1)
  }

  ## Age effects as second-order random walk (RW2)
  ## The first two age classes anchor the walk; subsequent
  ## increments are shrunk toward zero by precision tau_age.
  ## This replaces the 8 free b[2]...b[9] parameters.
 # tau_age ~ dgamma(1, 0.1)   # precision of RW2 increments
  tau_age ~ dgamma(2, 0.5)   # pulls sigma toward ~0.6 but allows flexibility
  sigma_age <- 1 / sqrt(tau_age)

  b_age[1] <- 0              # age class 1 is absorbed in intercept
  b_age[2] ~ dlogis(0, 1)   # free first step
  for (s in 3:S) {
    ## RW2: second differences are iid Normal(0, 1/tau_age)
    b_age[s] ~ dnorm(2 * b_age[s-1] - b_age[s-2], tau_age)
  }

  ## Region-specific population growth rates
  ## N and NC: informed by harvest index data (Willebrand et al.)
  ##   prior centered on 1.040 (posterior mean from original model)
  ##   with 95% mass between ~0.815 and 1.10 matching original range
  ## SC and S: wider prior reflecting greater uncertainty
  lambda[1] ~ dunif(0.8153, 1.1000)   # North
  lambda[2] ~ dunif(0.8153, 1.1000)   # North Central
  lambda[3] ~ dunif(0.7500, 1.1500)   # South Central (wider)
  lambda[4] ~ dunif(0.7500, 1.1500)   # South (wider)

  ## Dirichlet-multinomial concentration parameter
  ## phi > 0; larger phi -> closer to standard multinomial
  ## smaller phi -> more overdispersion
  ## log-normal prior allows wide range while keeping phi > 0
  log_phi ~ dnorm(3, 0.5)    # prior centered on phi ~ 20
  phi <- exp(log_phi)


  ## -------------------------------------------------------
  ## 2. STABLE STAGE DISTRIBUTION AND EXPECTED COUNTS
  ## -------------------------------------------------------

  for (i in 1:G) {

    ## --- Stage class 1 (sub-adults, first year) ---
    logit(p[i, 1]) <- b_intercept +
                      b_age[1] +
                      b_sex * sex[i] +
                      b_region[area[i]]
    g[i, 1] <- p[i, 1]   # probability of graduating to class 2
    z[i, 1] <- 0          # probability of remaining in class 1
    w[i, 1] <- 1          # anchor for stable stage calculation

    ## --- Stage classes 2 to S-1 (annual age classes) ---
    for (s in 2:(S - 1)) {
      logit(p[i, s]) <- b_intercept +
                        b_age[s] +
                        b_sex * sex[i] +
                        b_region[area[i]]
      g[i, s] <- p[i, s]
      z[i, s] <- 0
      w[i, s] <- g[i, s-1] / (lambda[area[i]] - z[i, s]) * w[i, s-1]
    }

    ## --- Final stage class S (oldest; individuals can remain) ---
    logit(p[i, S]) <- b_intercept +
                      b_age[S] +
                      b_sex * sex[i] +
                      b_region[area[i]]
    g[i, S] <- 0
    z[i, S] <- p[i, S]
    w[i, S] <- g[i, S-1] / (lambda[area[i]] - z[i, S]) * w[i, S-1]

    ## Stable stage distribution
    C[i, 1:S] <- w[i, 1:S] / sum(w[i, 1:S])

    ## Expected proportions in each stage class
    ey[i, 2] <- p[i, 1] * C[i, 1]
    ey[i, 3] <- p[i, 2] * C[i, 2]
    ey[i, 4] <- p[i, 3] * C[i, 3]
    ey[i, 5] <- p[i, 4] * C[i, 4]
    ey[i, 6] <- p[i, 5] * C[i, 5]
    ey[i, 7] <- p[i, 6] * C[i, 6]
    ey[i, 8] <- p[i, 7] * C[i, 7]
    ey[i, 9] <- p[i, 8] * C[i, 8] + p[i, 9] * C[i, 9]
    ey[i, 1] <- lambda[area[i]] - sum(ey[i, 2:9])

    ## Normalised expected proportions (theta) for Dirichlet-multinomial
    for (s in 1:S) {
      theta[i, s] <- ey[i, s] / sum(ey[i, 1:S])
    }


    ## -------------------------------------------------------
    ## 3. DIRICHLET-MULTINOMIAL LIKELIHOOD
    ## -------------------------------------------------------
    ##
    ## The Dirichlet-multinomial is implemented as a
    ## Dirichlet-Multinomial compound:
    ##   pi[i, ] ~ Dirichlet(phi * theta[i, ])
    ##   y[i, ]  ~ Multinomial(pi[i, ], N[i])
    ##
    ## In JAGS this is achieved by marginalising over pi,
    ## yielding the log-likelihood:
    ##   log p(y | theta, phi) =
    ##     loggam(phi) - loggam(N[i] + phi)
    ##     + sum_s [ loggam(y[i,s] + phi*theta[i,s])
    ##               - loggam(phi*theta[i,s]) ]
    ##
    ## We use the zeros trick to include this directly.

    ## Dirichlet-multinomial log-likelihood contribution for group i
    dm_ll[i] <- loggam(phi) - loggam(N[i] + phi) +
                sum(lgamma_y_phi[i, 1:S]) -
                sum(lgamma_phi_theta[i, 1:S])

    for (s in 1:S) {
      lgamma_y_phi[i, s]    <- loggam(y[i, s]   + phi * theta[i, s])
      lgamma_phi_theta[i, s] <- loggam(phi * theta[i, s])
    }

    ## Zeros trick: use Poisson(0) with offset -log_likelihood
    ## The constant C_zeros must be larger than max(-dm_ll)
    zeros[i] ~ dpois(zeros_mean[i])
    zeros_mean[i] <- C_zeros - dm_ll[i]


    ## -------------------------------------------------------
    ## 4. POSTERIOR PREDICTIVE CHECK
    ## -------------------------------------------------------
    ##
    ## Simulate replicate data from the Dirichlet-multinomial
    ## and compute G-statistic for observed and replicated data.
    ## Bayesian p-value = Pr(G_new > G_obs).

    ## Simulate Dirichlet mixing proportions
    for (s in 1:S) {
      ## Gamma trick for Dirichlet: pi_raw ~ Gamma(phi*theta, 1)
      pi_raw[i, s] ~ dgamma(phi * theta[i, s], 1)
    }
    ## Normalise to get Dirichlet sample
    for (s in 1:S) {
      pi_sim[i, s] <- pi_raw[i, s] / sum(pi_raw[i, 1:S])
    }
    ## Multinomial replicate draw
    y_new[i, 1:S] ~ dmulti(pi_sim[i, 1:S], N[i])

    ## G-statistic contributions
    for (s in 1:S) {
      g_obs[i, s] <- y[i, s] *
        log(max(y[i, s], 0.001) / max(N[i] * theta[i, s], 0.001))
      g_new[i, s] <- y_new[i, s] *
        log(max(y_new[i, s], 0.001) / max(N[i] * theta[i, s], 0.001))
    }

  } ## end group loop


  ## -------------------------------------------------------
  ## 5. GLOBAL POSTERIOR PREDICTIVE STATISTICS
  ## -------------------------------------------------------

  cs_obs <- 2 * sum(g_obs)
  cs_new <- 2 * sum(g_new)
  bp     <- step(cs_new - cs_obs)   # Bayesian p-value

} ## end model
