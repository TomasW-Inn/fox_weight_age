## modelAgeSexArea_v5.jags
##
## Bayesian age-at-harvest survival model for Red fox
## following Skelly et al. (2023).
##
## Improvements over original modelAgeSexArea2.jags:
##   1. Region-specific lambda[r] instead of single shared lambda
##   2. Area coded as index 1:4 instead of dummy variables
##
## Deliberately simple likelihood: standard multinomial, identical
## to the original model. The Dirichlet-multinomial (v2-v4) was
## dropped because the gamma-trick PPC simulation was numerically
## unstable in JAGS whenever theta approached zero during sampling.
## phi >> 500 in v2-v4 anyway, confirming the multinomial is
## appropriate for these data.
##
## Data required:
##   y[i, 1:S]  - observed counts, group i, stage class s
##   N[i]       - total harvest in group i  (rowSums of y)
##   S          - number of stage classes (8: age 0..6 + "7+")
##   G          - number of groups (8: 4 regions x 2 sexes)
##   sex[i]     - 0=male, 1=female
##   area[i]    - region index 1:4 (N, NC, SC, S)

model {

  ## -------------------------------------------------------
  ## 1. PRIORS
  ## -------------------------------------------------------

  b_intercept ~ dlogis(0, 1)
  b_sex       ~ dlogis(0, 1)

  b_region[1] <- 0
  for (r in 2:4) {
    b_region[r] ~ dlogis(0, 1)
  }

  ## Free age effects, logistic(0,1) as in original
  b_age[1] <- 0
## With:
tau_b ~ dgamma(2, 0.5)          # shared precision ~ encourages shrinkage
for (s in 2:S) {
  b_age[s] ~ dnorm(0, tau_b)    # partial pooling across age effects
}
  ## Region-specific population growth rates
  lambda[1] ~ dunif(0.8153, 1.1000)   # N
  lambda[2] ~ dunif(0.8153, 1.1000)   # NC
  lambda[3] ~ dunif(0.7500, 1.1500)   # SC
  lambda[4] ~ dunif(0.7500, 1.1500)   # S


  ## -------------------------------------------------------
  ## 2. STABLE STAGE DISTRIBUTION AND EXPECTED COUNTS
  ## -------------------------------------------------------

  for (i in 1:G) {

    ## Stage class 1
    logit(p[i, 1]) <- b_intercept + b_age[1] +
                      b_sex * sex[i] + b_region[area[i]]
    g[i, 1] <- p[i, 1]
    z[i, 1] <- 0
    w[i, 1] <- 1

    ## Stage classes 2 to S-1
    for (s in 2:(S - 1)) {
      logit(p[i, s]) <- b_intercept + b_age[s] +
                        b_sex * sex[i] + b_region[area[i]]
      g[i, s] <- p[i, s]
      z[i, s] <- 0
      w[i, s] <- g[i, s-1] / (lambda[area[i]] - z[i, s]) * w[i, s-1]
    }

    ## Final stage class S ("7+", individuals can remain)
    logit(p[i, S]) <- b_intercept + b_age[S] +
                      b_sex * sex[i] + b_region[area[i]]
    g[i, S] <- 0
    z[i, S] <- p[i, S]
    w[i, S] <- g[i, S-1] / (lambda[area[i]] - z[i, S]) * w[i, S-1]

    ## Stable stage distribution
    C[i, 1:S] <- w[i, 1:S] / sum(w[i, 1:S])

    ## Expected proportions
    ey[i, 2] <- p[i, 1] * C[i, 1]
    ey[i, 3] <- p[i, 2] * C[i, 2]
    ey[i, 4] <- p[i, 3] * C[i, 3]
    ey[i, 5] <- p[i, 4] * C[i, 4]
    ey[i, 6] <- p[i, 5] * C[i, 5]
    ey[i, 7] <- p[i, 6] * C[i, 6]
    ey[i, 8] <- p[i, 7] * C[i, 7] + p[i, 8] * C[i, 8]
    ey[i, 1] <- lambda[area[i]] - sum(ey[i, 2:8])

    ## -------------------------------------------------------
    ## 3. MULTINOMIAL LIKELIHOOD
    ## -------------------------------------------------------

    y[i, 1:S] ~ dmulti(ey[i, 1:S], N[i])

    ## -------------------------------------------------------
    ## 4. POSTERIOR PREDICTIVE CHECK
    ## -------------------------------------------------------

    y_new[i, 1:S] ~ dmulti(ey[i, 1:S], N[i])

    for (s in 1:S) {
      g_obs[i, s] <- y[i, s] *
        log(max(y[i, s], 0.001) / max(N[i] * ey[i, s] / sum(ey[i, 1:S]), 0.001))
      g_new[i, s] <- y_new[i, s] *
        log(max(y_new[i, s], 0.001) / max(N[i] * ey[i, s] / sum(ey[i, 1:S]), 0.001))
    }

  } ## end group loop


  ## -------------------------------------------------------
  ## 5. GLOBAL POSTERIOR PREDICTIVE STATISTICS
  ## -------------------------------------------------------

  cs_obs <- 2 * sum(g_obs)
  cs_new <- 2 * sum(g_new)
  bp     <- step(cs_new - cs_obs)

} ## end model
